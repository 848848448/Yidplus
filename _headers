# Security headers for all pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(self), microphone=(self), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# JS/CSS are requested with a ?v=<build> query that changes on every deploy, so
# the file at a given URL never changes — cache it hard. Without this, Pages
# serves them as must-revalidate and the browser re-checks ~300KB of scripts
# with the server on EVERY page load, which is the main source of slowness.
/js/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable
# The folder is images/ — /img/* matched nothing, so the icons were never
# getting a cache header at all.
/images/*
  Cache-Control: public, max-age=604800

# Never let the browser cache HTML — it references versioned JS/CSS, so a
# stale HTML is what causes "I deployed but still see the old app".
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

# Clean URLs (Cloudflare Pages serves /yidplus-admin for yidplus-admin.html, with
# no ".html" in the path) — the *.html rule above misses these, so pin them too.
# Without this the browser caches the page HTML and keeps loading old versioned JS.
/yidplus-admin
  Cache-Control: no-cache, no-store, must-revalidate
/yidplus-chat
  Cache-Control: no-cache, no-store, must-revalidate
/yidplus-music
  Cache-Control: no-cache, no-store, must-revalidate
/yidplus-shorts
  Cache-Control: no-cache, no-store, must-revalidate
/admin
  Cache-Control: no-cache, no-store, must-revalidate
/chat
  Cache-Control: no-cache, no-store, must-revalidate
/music
  Cache-Control: no-cache, no-store, must-revalidate
/shorts
  Cache-Control: no-cache, no-store, must-revalidate
