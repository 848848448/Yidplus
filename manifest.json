{
  "name": "YID PLUS",
  "short_name": "YID+",
  "description": "The Jewish social platform",
  "lang": "yi",
  "dir": "rtl",
  "start_url": "/chat",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FFFFFF",
  "theme_color": "#1F6F5C",
  "orientation": "portrait",
  "icons": [
    { "src": "/images/icon-192.png?v=202607241637", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/images/icon-512.png?v=202607241637", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/images/icon-192-maskable.png?v=202607241637", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/images/icon-512-maskable.png?v=202607241637", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Chats", "url": "/chat" },
    { "name": "Channels", "url": "/?goto=explore" },
    { "name": "Shorts", "url": "/shorts" }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "media", "accept": ["image/*", "video/*", "audio/*", ".pdf"] }
      ]
    }
  }
}
